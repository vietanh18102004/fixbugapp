<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:EcoLand.Views"
             x:Class="EcoLand.Views.Pages.PinDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid>
        <!-- Vùng trong suốt phía trên - bấm để đóng -->
        <BoxView BackgroundColor="Transparent" VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Sheet chiếm full chiều cao -->
        <Border x:Name="SheetPanel"
                VerticalOptions="Fill"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=White}"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="20" Offset="0,-5" />
            </Border.Shadow>

            <Grid RowDefinitions="auto,*">

                <!-- VÙNG KÉO + TAP: handle bar + ảnh + tiêu đề -->
                <StackLayout Grid.Row="0"
                             Padding="15,10,15,0"
                             Spacing="10"
                             BackgroundColor="Transparent">

                    <!-- Gesture kéo -->
                    <StackLayout.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
                        <TapGestureRecognizer Tapped="OnDetailClicked" />
                    </StackLayout.GestureRecognizers>

                    <!-- Handle bar -->
                    <BoxView HeightRequest="4" WidthRequest="40"
                             HorizontalOptions="Center"
                             Color="{DynamicResource Gray200}"
                             CornerRadius="2" />

                    <!-- Ảnh -->
                    <Border HeightRequest="180"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                        <Image x:Name="PropertyImage" Aspect="AspectFill" />
                    </Border>

                    <!-- Tiêu đề -->
                    <Label x:Name="HeaderLabel"
                           FontSize="16"
                           Margin="0,0,0,10"
                           TextTransform="Uppercase"
                           TextColor="{DynamicResource Black}"
                           FontAttributes="Bold" />

                </StackLayout>

                <!-- VÙNG CUỘN: phần còn lại -->
                <ScrollView Grid.Row="1" x:Name="SheetScrollView"
                            Padding="15,0,15,30">
                    <StackLayout Spacing="10">

                        <!-- Giá -->
                        <Label x:Name="PriceLabel" />

                        <!-- Thời gian -->
                        <Label x:Name="TimeAgoLabel" TextColor="Black" />

                        <!-- Chi tiết -->
                        <Grid ColumnDefinitions="auto,*"
                              RowDefinitions="*,*,*,*"
                              ColumnSpacing="10" RowSpacing="10">
                            <Label Text="{x:Static views:FaPro.LocationArrow}"
                                   FontFamily="FaPro" TextColor="#3b82f6" />
                            <Label x:Name="DistanceLabel" Grid.Column="1" TextColor="#666" />
                            <Label Text="{x:Static views:MaterialDesignIcons.LocationOn}"
                                   FontFamily="MaterialDesign"
                                   TextColor="{DynamicResource Primary}"
                                   Grid.Row="1" FontSize="18" />
                            <Label x:Name="AddressLabel" Grid.Column="1" Grid.Row="1" TextColor="#666" />
                            <Label Text="{x:Static views:FaPro.Building}"
                                   FontFamily="FaPro" TextColor="#666" Grid.Row="2" />
                            <Label x:Name="TypeLabel" Grid.Column="1" Grid.Row="2" TextColor="#666" />
                            <Label Text="{x:Static views:FaPro.Bed}"
                                   FontFamily="FaPro" TextColor="#666" Grid.Row="3" />
                            <HorizontalStackLayout Grid.Row="3" Grid.Column="1" Spacing="10">
                                <Label x:Name="BedroomLabel" TextColor="#666" />
                                <Label Text="{x:Static views:FaPro.Bath}"
                                       FontFamily="FaPro" TextColor="#666" />
                                <Label x:Name="BathroomLabel" TextColor="#666" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Line X2="1000" Stroke="#666" StrokeThickness=".5" />

                        <!-- Người bán -->
                        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10">
                            <Border HeightRequest="50" WidthRequest="50"
                                    StrokeShape="RoundRectangle 25" StrokeThickness="0">
                                <Image x:Name="AvatarImage" Aspect="AspectFill" />
                            </Border>
                            <Label x:Name="FullnameLabel" Grid.Column="1" VerticalOptions="Center" />
                            <Button Background="{DynamicResource Primary}"
                                    Grid.Column="2" Text="Gọi"
                                    VerticalOptions="Center"
                                    Clicked="OnCallClicked">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaPro"
                                                     Glyph="{x:Static views:FaPro.PhoneAlt}"
                                                     Color="White" Size="14" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>

                    </StackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>